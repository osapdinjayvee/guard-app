<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The release manifest sets usesCleartextTraffic="false" (HTTPS-only, per PRD §9).
      Debug builds talk to a local MockWebServer over http://10.0.2.2, so cleartext is
      re-enabled here and here only. This override never reaches a release APK.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />

</manifest>
