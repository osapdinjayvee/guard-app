<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The release manifest sets usesCleartextTraffic="false" (HTTPS-only, per PRD §9).

      Debug builds talk to the local EnvKit backend, which serves guard.test with a certificate it
      signed itself. network_security_config.xml trusts that certificate for guard.test alone and
      leaves every other host validated against the system store. Neither override can reach a
      release APK — both live in the debug source set.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />

</manifest>
