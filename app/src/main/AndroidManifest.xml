<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required to observe connectivity for the online/offline indicator. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Fine location: the PRD requires GPS accuracy in metres, which coarse cannot give. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      The app updates itself.

      It is distributed by sideloading, not through Play, so there is no store to notice a new
      version and no store to install it. The app checks a manifest beside the APK and installs
      the download itself, which is what this permission is for. Android still asks the guard to
      allow installs from this app the first time, and still shows its own install confirmation —
      this grants the right to ask, not the right to install silently.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!--
      Backup is off.

      This app's data is evidence: photographs of guards' faces, the GPS coordinates where each was
      taken, the timestamps, and a live session token for the attendance API. Android's Auto Backup
      is on by default, and it copies exactly that to the user's Google Drive and into
      device-to-device transfers — off MinSU's premises and outside its control, in a personal
      account the university does not administer.

      This was not theoretical: reinstalling the app during release testing silently restored a
      previous session, still signed in, from a cloud backup nobody had asked for.

      A guard who loses their phone should lose access to the app, not hand a stranger the last
      month of their movements. There is nothing here worth restoring — checkpoints and duties
      re-download in seconds, and an unsynced attendance is meant to be uploaded, not resurrected on
      a different handset.
    -->
    <application
        android:name=".GuardApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuardApp"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GuardApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google Maps API key, injected from the MAPS_API_KEY Gradle property (see
             build.gradle.kts). Empty when unset: the map renders blank rather than failing the build. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Hilt supplies the WorkManager configuration (Configuration.Provider on the
             Application), so the default on-startup initializer must be removed. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
