<!--
  The torch toggle on the scanner.

  A bolt rather than a hand-torch: it is what every camera app puts on this control, and a guard
  reaching for light at 2am should not have to work out what the button means. Drawn as a stroked
  outline to match the rest of the set; the colour here is a placeholder, since Icon() tints it with
  the content colour of whatever it sits in.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M13.5,2.25 L4.5,13.5 h6 l-1.5,8.25 9,-11.25 h-6 z"
        android:strokeColor="#FF005825"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />
</vector>
