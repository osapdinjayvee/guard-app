<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon's background layer: MinSU green, edge to edge.

  Flat on purpose. The launcher masks this to whatever shape the OEM uses and parallaxes it
  under the seal, so anything drawn here has to survive being cropped to a circle, a squircle
  or a teardrop — a pattern would be sliced differently on every phone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#005825" />
</vector>
