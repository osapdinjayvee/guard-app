<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules, applied below API 31. See data_extraction_rules.xml for API 31+.

  Excluded:
  - session: the encrypted bearer token. Its AndroidKeyStore key is never backed up, so a
    restored copy is undecryptable regardless; excluding it avoids shipping ciphertext at all.
  - guard.db: unsynced attendance records, GPS coordinates, and selfie paths.
  - attendance/: the captured selfies themselves.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/session.preferences_pb" />
    <exclude domain="database" path="guard.db" />
    <exclude domain="database" path="guard.db-shm" />
    <exclude domain="database" path="guard.db-wal" />
    <exclude domain="file" path="attendance" />
</full-backup-content>
