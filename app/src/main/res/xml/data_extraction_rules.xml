<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+. Attendance evidence and the session token stay on the device that captured them.

  device-transfer excludes the same data: a direct device-to-device transfer would otherwise
  move unsynced attendance records onto hardware that did not capture them, which undermines
  the evidence trail even though the ciphertext remains unreadable without the keystore key.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
        <exclude domain="database" path="guard.db" />
        <exclude domain="database" path="guard.db-shm" />
        <exclude domain="database" path="guard.db-wal" />
        <exclude domain="file" path="attendance" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
        <exclude domain="database" path="guard.db" />
        <exclude domain="database" path="guard.db-shm" />
        <exclude domain="database" path="guard.db-wal" />
        <exclude domain="file" path="attendance" />
    </device-transfer>
</data-extraction-rules>
